<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Base.Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="postSplashScreenTheme">@style/Theme.MangaReader</item>
    </style>

    <!-- Without an icon, the splash screen library shows a generic one below Android 12. -->
    <style name="Theme.App.Starting" parent="Base.Theme.App.Starting">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
    </style>

    <style name="Theme.MangaReader" parent="Theme.Material3.DayNight.NoActionBar"/>
</resources>
