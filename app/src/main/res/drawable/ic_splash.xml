<?xml version="1.0" encoding="utf-8"?>
<!-- Splash icon for versions below Android 12, which don't use the launcher icon by themselves. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The circle fills the middle two thirds, the part the splash screen leaves visible. -->
    <item
        android:width="192dp"
        android:height="192dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@color/launcher_background" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_launcher_foreground"
        android:width="288dp"
        android:height="288dp" />
</layer-list>
